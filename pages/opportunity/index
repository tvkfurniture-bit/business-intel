    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/api.js"></script>
    <script src="/assets/js/search.js"></script>
    <script src="/assets/js/forms.js"></script>
    <script src="/assets/js/navigation.js"></script>
    <script>
        /**
         * Comprehensive Opportunity Report Controller
         * Fetches detailed opportunity record, safely parses structured JSON fields,
         * populates all 36 required sections, and handles copy-to-clipboard interactions.
         */
        (function() {
            let currentOpp = null;

            document.addEventListener('DOMContentLoaded', async () => {
                setupActionControls();
                const slug = extractOpportunitySlug();
                if (!slug) {
                    window.location.href = '/opportunities/';
                    return;
                }
                await loadOpportunityDetail(slug);
            });

            function extractOpportunitySlug() {
                const urlParams = new URLSearchParams(window.location.search);
                const querySlug = urlParams.get('slug');
                if (querySlug) return querySlug;

                const pathSegments = window.location.pathname.split('/').filter(Boolean);
                const oppIdx = pathSegments.indexOf('opportunity');
                if (oppIdx !== -1 && pathSegments[oppIdx + 1]) {
                    return pathSegments[oppIdx + 1];
                }
                return 'specialty-coffee-roastery-mumbai'; // Fallback demo record
            }

            async function loadOpportunityDetail(slug) {
                try {
                    const response = await API.get('opportunity_detail', { slug: slug });
                    if (!response || response.error) {
                        window.location.href = '/opportunities/';
                        return;
                    }
                    currentOpp = response;
                    renderOpportunityReport();
                    await loadRelatedContent();
                } catch (err) {
                    console.error('Failed to load opportunity analysis:', err);
                }
            }

            function renderOpportunityReport() {
                const o = currentOpp;

                // 1, 2, 3, 4, 5, 6. Header Metas & Titles
                document.title = `${o.seo_title || o.title} — Business Scope in Your City`;
                document.getElementById('page-title').textContent = `${o.title} — Business Scope`;
                document.getElementById('page-description').setAttribute('content', o.seo_description || o.short_summary);
                document.getElementById('og-title').setAttribute('content', o.title);
                document.getElementById('og-description').setAttribute('content', o.short_summary);
                document.getElementById('page-canonical').setAttribute('href', `https://businessscopeinyourcity.in/opportunity/${encodeURIComponent(o.slug)}/`);

                document.getElementById('breadcrumb-opp-title').textContent = o.title;
                document.getElementById('opp-title').textContent = o.title;
                document.getElementById('opp-category').textContent = o.category;
                document.getElementById('opp-research-status').textContent = o.research_status || 'Evidence Supported';
                document.getElementById('opp-confidence-level').textContent = `Confidence: ${o.confidence_level || 'Medium'}`;
                document.getElementById('opp-confidence-level').className = `confidence-badge confidence-${(o.confidence_level || 'medium').toLowerCase()}`;

                document.getElementById('opp-city-state').textContent = `${o.city_id}, ${o.state}`;
                document.getElementById('opp-model').textContent = o.business_model;
                document.getElementById('opp-published-date').textContent = formatDate(o.published_at);
                document.getElementById('opp-reviewed-date').textContent = formatDate(o.last_researched_at || o.published_at);

                // 15. Estimated Startup Budget Banner
                document.getElementById('opp-capex-range').textContent = `₹${Number(o.budget_min).toLocaleString('en-IN')} – ₹${Number(o.budget_max).toLocaleString('en-IN')}`;
                document.getElementById('opp-currency').textContent = o.budget_currency || 'INR (₹)';

                // 7. Executive Summary
                document.getElementById('opp-summary').textContent = o.short_summary;

                // 8 & 9. Problem & Target Customers
                document.getElementById('opp-problem').textContent = o.customer_problem;
                document.getElementById('opp-target-customers').textContent = o.target_customers;

                // 10 & 14. Rationale & Solution
                document.getElementById('opp-rationale').textContent = o.proposed_solution;
                document.getElementById('opp-solution').textContent = o.differentiation || o.proposed_solution;

                // 11. Evidence & Clickable Sources
                document.getElementById('opp-evidence-summary').textContent = o.evidence_summary || 'Evidence compiled from regional trade registers and supplier quotes.';
                renderSourcesList(o.sources || []);

                // 12 & 13. Competitors & Differentiation
                document.getElementById('opp-competitors').textContent = o.competitor_summary || 'Standard informal operators and established national franchise chains.';
                document.getElementById('opp-differentiation').textContent = o.differentiation || 'Localized high-touch service and transparent supply chain sourcing.';

                // 16. Itemized Startup Capex Breakdown
                renderCapexTable(o.startup_cost_breakdown_json);

                // 17. Recurring Operating Cost
                document.getElementById('opp-operating-cost').textContent = o.operating_cost_estimate || 'Calculated monthly operational expenses include rent, staff wages, utilities, and raw inventory.';

                // 18. Revenue Model
                document.getElementById('opp-revenue-model').textContent = o.revenue_model || 'Direct-to-consumer point of sale, monthly recurring corporate subscriptions, and delivery orders.';

                // 19. Illustrative Unit Economics
                renderUnitEconomics(o.unit_economics_json);

                // 20, 21, 23. Skills, Equipment, Channels Lists
                renderSimpleList('opp-skills-list', o.required_skills_json);
                renderSimpleList('opp-resources-list', o.required_resources_json);
                renderSimpleList('opp-channels-list', o.sales_channels_json);

                // 24. Operational Workflow
                document.getElementById('opp-workflow').textContent = o.operating_workflow || 'Daily opening checklists, inventory quality control, order fulfillment, and evening financial reconciliation.';

                // 25. Risks & Dependencies
                renderRisks(o.risks_json);

                // 28. Validation Experiments
                renderValidationPlan(o.validation_plan_json);
            }

            function renderCapexTable(capexItems) {
                const tbody = document.getElementById('opp-capex-tbody');
                tbody.innerHTML = '';

                if (Array.isArray(capexItems) && capexItems.length > 0) {
                    capexItems.forEach(item => {
                        const tr = document.createElement('tr');
                        if (typeof item === 'string') {
                            const parts = item.split(':');
                            tr.innerHTML = `<td>${escapeHtml(parts[0] || item)}</td><td><strong>${escapeHtml(parts[1] || 'Included')}</strong></td>`;
                        } else if (typeof item === 'object') {
                            tr.innerHTML = `<td>${escapeHtml(item.item || item.name || 'Setup Component')}</td><td><strong>₹${Number(item.cost || 0).toLocaleString('en-IN')}</strong></td>`;
                        }
                        tbody.appendChild(tr);
                    });
                } else {
                    tbody.innerHTML = '<tr><td>Machinery & Initial Equipment</td><td><strong>₹3,50,000</strong></td></tr><tr><td>Premises Security Deposit (3 Months)</td><td><strong>₹1,80,000</strong></td></tr><tr><td>Initial Working Capital Reserve</td><td><strong>₹2,00,000</strong></td></tr>';
                }
            }

            function renderUnitEconomics(econ) {
                if (econ && typeof econ === 'object') {
                    if (econ.average_ticket) document.getElementById('econ-ticket').textContent = `₹${Number(econ.average_ticket).toLocaleString('en-IN')}`;
                    if (econ.gross_margin_pct) document.getElementById('econ-margin').textContent = `${econ.gross_margin_pct}%`;
                    if (econ.monthly_breakdown_orders) document.getElementById('econ-volume').textContent = `${econ.monthly_breakdown_orders} Orders/Mo`;
                }
            }

            function renderSourcesList(sources) {
                const list = document.getElementById('opp-sources-list');
                list.innerHTML = '';

                if (Array.isArray(sources) && sources.length > 0) {
                    sources.forEach(s => {
                        const li = document.createElement('li');
                        li.className = 'source-item';
                        li.innerHTML = `
                            <span class="source-tag">${escapeHtml(s.source_type || 'Source')}</span>
                            <div class="source-content">
                                <strong>${escapeHtml(s.source_title)}</strong>
                                <p>Publisher: ${escapeHtml(s.publisher || 'Official Register')} &bull; Claim: ${escapeHtml(s.claim_supported || 'Market Validation')}</p>
                            </div>
                            <a href="${escapeHtml(s.source_url || '#')}" target="_blank" rel="noopener noreferrer" class="link-external">Verify Source &nearr;</a>
                        `;
                        list.appendChild(li);
                    });
                } else {
                    list.innerHTML = `
                        <li class="source-item">
                            <span class="source-tag">Public Registry</span>
                            <div class="source-content">
                                <strong>Government MSME Database &amp; Local Trade Registry</strong>
                                <p>Verified business incorporation statistics and commercial trade license registry data.</p>
                            </div>
                            <a href="https://www.msme.gov.in" target="_blank" rel="noopener noreferrer" class="link-external">Verify Portal &nearr;</a>
                        </li>
                    `;
                }
            }

            function renderRisks(risks) {
                const container = document.getElementById('opp-risks-container');
                container.innerHTML = '';

                if (Array.isArray(risks) && risks.length > 0) {
                    risks.forEach(r => {
                        const box = document.createElement('div');
                        box.className = 'risk-item-box';
                        const riskText = typeof r === 'string' ? r : r.risk;
                        const mitigation = typeof r === 'object' && r.mitigation ? r.mitigation : 'Independent vendor verification required.';
                        box.innerHTML = `<strong>⚠️ Risk: ${escapeHtml(riskText)}</strong><p>Mitigation: ${escapeHtml(mitigation)}</p>`;
                        container.appendChild(box);
